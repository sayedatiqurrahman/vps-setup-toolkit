[Unit]
Description=VPS Setup Toolkit - persistent Docker firewall and network reconciler
Documentation=file:///usr/local/lib/vps-setup-toolkit/docs/FIREWALL.md
After=network-online.target nftables.service docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/vps-firewall-watch
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/vps-setup /var/log/vps-setup /var/backups/vps-setup /run

[Install]
WantedBy=multi-user.target
